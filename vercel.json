{
  "functions": {
    "api/agent-brain.js": { "maxDuration": 60 },
    "api/cron.js": { "maxDuration": 60 },
    "api/school.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(accounting|german|math|chinese|school)/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(accounting|german|math|chinese|school)/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(accounting|german|math|chinese|school)/icon-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?job=daily",
      "schedule": "0 0 * * 1-5"
    },
    {
      "path": "/api/cron?job=evening",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron?job=weekly",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/agent-brain?action=study&agent=all&count=2",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/agent-brain?action=self-study&agent=all",
      "schedule": "0 3 * * *"
    }
  ]
}
