{
  "functions": {
    "api/agent-brain.js": { "maxDuration": 300 },
    "api/cron/weekly-reflection.js": { "maxDuration": 300 },
    "api/cron/daily-report.js": { "maxDuration": 120 },
    "api/cron/evening-report.js": { "maxDuration": 120 }
  },
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 0 * * 1-5"
    },
    {
      "path": "/api/cron/evening-report",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/weekly-reflection",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/agent-brain?action=study&agent=all&count=2",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/agent-brain?action=self-study&agent=all",
      "schedule": "0 3 * * *"
    }
  ]
}
